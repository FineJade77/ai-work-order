# Copy to .env (git-ignored); docker compose reads it automatically.

# Required: ai-gateway calls DeepSeek with it. Get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Optional: service-to-service tokens and the JWT signing secret. Unset, compose falls back to
# the dev defaults below, which are fine locally and must never be used in a real deployment.
# TOOL_GATEWAY_SERVICE_TOKEN=dev-tool-gateway-token
# KNOWLEDGE_SERVICE_TOKEN=dev-knowledge-service-token
# TICKET_SERVICE_TOKEN=dev-ticket-service-token
# AI_GATEWAY_SERVICE_TOKEN=dev-ai-gateway-token
# JWT_SECRET=dev-jwt-secret-change-me-in-any-real-deployment
