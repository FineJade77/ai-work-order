    {
      "type": "timeseries",
      "title": "积压与待确认",
      "id": 7,
      "description": "积压：还没投递给消费组；待确认：已投递、还没 ACK（正在处理，或 worker 崩溃后等接管）。每个副本都上报同样的值，所以取 max。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (messaging_destination_name) (app_queue_lag)",
          "legendFormat": "积压 {{messaging_destination_name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (messaging_destination_name) (app_queue_pending)",
          "legendFormat": "待确认 {{messaging_destination_name}}",
          "refId": "B"
        }
      ]
    },
